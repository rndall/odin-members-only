<li class="space-y-3 card<%= locals.class %>">
  <h3 class="font-bold text-2xl"><%= message.title %></h3>
  <p class="flex gap-3 text-gray">
    <% if (locals.currentUser) { %>
    <span class="italic text-light">
      <%= message.first_name %> <%= message.last_name %>
    </span>
    •
    <span>
      <%= message.distanceToNow %>
    </span>
    <% } else { %>
      by Anonymous Member
    <% } %>
  </p>

  <p><%= message.content %></p>
</li>
