<li class="card flex<%= locals.class %>">
  <div class="space-y-3 flex-1">
    <h3 class="font-bold text-2xl"><%= message.title %></h3>
    <p class="flex flex-col sm:flex-row sm:gap-3 text-gray">
      <% if (locals.currentUser?.is_member) { %>
      <span class="italic text-light">
        <%= message.first_name %> <%= message.last_name %>
      </span>
      <span class="hidden sm:block">•</span>
      <span>
        <%= message.distanceToNow %>
      </span>
      <% } else { %>
        by Anonymous Member
      <% } %>
    </p>

    <p><%= message.content %></p>
  </div>

  <% if (currentUser?.is_admin) { %>
    <form
      action="/<%= message.id %>?_method=DELETE"
      method="POST"
    >
      <button
        type="submit"
        class="text-gray shrink-0 p-0"
      >
        <%- trashIcon %>
      </button>
    </form>
  <% } %>
</li>
