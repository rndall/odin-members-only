<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/output.css" />
    <title>Login</title>
  </head>

  <body class="min-h-dvh flex flex-col">
    <%- include("header") %>

    <main class="flex-1 flex items-center justify-center container mx-auto px-4 -mt-20">
      <div class="flex-1 space-y-8 max-w-110 text-center shadow-lg bg-dark rounded-xl p-8">
        <div class="space-y-2 max-w-110 mx-auto">
          <h2 class="font-bold text-3xl">Welcome Back<h2>
          <p>Enter the clubhouse to join the conversation</p>
        </div>

        <form class="flex flex-col gap-3 text-start" action="/login" method="POST">
          <div class="flex flex-col gap-2">
            <label for="email">Email</label>
            <input
              class="border-2 border-light/20 bg-bg/80 rounded-md shadow-sm py-2 px-4"
              type="email"
              id="email"
              name="email"
              placeholder="you@example.com"
              value="<%= locals.user?.email ?? "" %>"
              autofocus
              required
            />
            <%- include("partials/error", { field: "email" }) %>
          </div>

          <div class="flex flex-col gap-2">
            <label for="password">Password</label>
            <input
              class="border-2 border-light/20 bg-bg/80 rounded-md shadow-sm py-2 px-4"
              type="password"
              id="password"
              name="password"
              placeholder="Enter your password"
              required
            />
            <%- include("partials/error", { field: "password" }) %>
          </div>

          <%- include("partials/error") %>

          <button type="submit" class="bg-cta">Log In</button>
        </form>
      </div>
    </main>
  </body>
</html>
