<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/output.css" />
    <title><%= title %></title>
  </head>

  <body class="min-h-screen relative">
    <%- include("header") %>

    <main class="container mx-auto px-4 space-y-6 mt-12 pb-12">
      <h2 class="font-bold text-3xl">Clubhouse Feed</h2>

      <div>
        <% if (messages.length > 0) { %>
          <ul class="border-2 border-dark rounded-lg">
            <% messages.forEach((message, index) => { %>
              <%-
                include("messages/message",
                {
                  message,
                  class: messages.length - 1 === index ?
                  "" :
                  " border-b-2 border-b-dark"
                })
              %>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </main>

    <% if (locals.currentUser) { %>
      <a
        href="/new"
        class="bg-cta size-12 text-xl p-0 rounded-full fixed right-5 bottom-5 text-center content-center"
      >
        +
      </a>
    <% } %>
</html>
