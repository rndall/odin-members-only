<header
  class="flex justify-between items-center mb-12 border-b-2 border-b-dark px-4 sm:px-6 py-3<%= locals.class %>"
>
  <a class="flex gap-3 items-center p-0" href="/">
    <%- icon %>
    <h1 class="hidden sm:block font-bold text-xl">The Clubhouse</h1>
  </a>

  <div class="flex gap-4 items-center">
    <% if (!locals.currentUser) { %>
      <a
        class="bg-dark"
        href="/login"
        >Login</a
      >
      <a
        class="bg-cta"
        href="/sign-up"
        >Sign Up</a
      >
    <% } else { %>
      <a
        class="bg-cta"
        href="/join"
        >Join the Club</a
      >
    <% } %>
  </div>
</header>
